.DS_Store
**/.DS_Store

# engine/    -> ../pokered-daemons      (Game Boy, the classic build)
# engineGba/ -> ../pokefirered-daemons  (GBA, under evaluation)
# Sibling repos, never vendored: both carry Nintendo-derived graphics.
engine
engineGba

# built ROMs and their debug artefacts
engine/*.gbc
engine/*.sav
engineGba/*.gba
engineGba/*.sav

# audio working files -- the venv, the stems and the transcriptions
# basic-pitch needs Python 3.11 and pulls ~3.4M lines including a 123MB
# llvmlite dylib, which GitHub rejects outright. tools/bpextract.py rebuilds it.
bpvenv/
notes/
notes-*/
audio/music/**/*.mp3
audio/music/**/*.wav
.DS_Store

# python scratch
__pycache__/
*.pyc

# generated from the ELF by tools/gbasym.py -- rebuilt every --ai run
ai/pokefirered.sym
ai/logs/

# engineAi/ -> ../gpt-play-pokemon-firered-daemons  (the AI-play harness)
engineAi

# the bridge venv -- rebuilt by ./bindDaemons.sh --ai when absent
ai/bridgevenv/
