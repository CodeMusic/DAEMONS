{
  "name": "DAEMONS Public \u2014 daemon/sprite relay",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "daemon/sprite",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "r1",
      "name": "Public Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "pub-daemon-sprite"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://10.0.0.136:5678/webhook/daemon/sprite",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-dex-secret",
              "value": "={{ $json.headers['x-dex-secret'] || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "r2",
      "name": "Relay to Internal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        0
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const j=($input.first()||{}).json||{};\nif (!j.spriteBase64) return [{ json: { spriteBase64: null, error: 'backend_unreachable' } }];\nreturn [{ json: j }];"
      },
      "id": "r3",
      "name": "Shape Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "r4",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        672,
        0
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Public Webhook": {
      "main": [
        [
          {
