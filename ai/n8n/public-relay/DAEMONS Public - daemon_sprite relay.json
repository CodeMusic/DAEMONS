        0
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// The request body is relayed wholesale, so `kind`, `backend`, `model` and\n// `baseline` all reach the internal workflow without this node doing anything.\n// What it must not do is DROP the metadata coming back.\n//\n// A caller that cannot tell which rule drew a sprite, which backend drew it,\n// or whether a baseline was honoured, cannot tell a correct sprite from a\n// wrong one -- all three look equally deliberate. That is the whole reason\n// those parameters exist, and a relay that swallows them undoes it.\nconst j = ($input.first() || {}).json || {};\nif (!j.spriteBase64) {\n  return [{ json: {\n    kind: j.kind || null,\n    backend: j.backend || null,\n    model: j.model || null,\n    spriteBase64: null,\n    error: j.error || 'backend_unreachable',\n  } }];\n}\nreturn [{ json: j }];"
      },
      "id": "r3",
      "name": "Shape Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "r4",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
